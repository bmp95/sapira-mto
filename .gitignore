# ---------------------------------------------------------------------------
# Secretos. Nunca al repositorio.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
secrets/

# ---------------------------------------------------------------------------
# Generado y regenerable
# ---------------------------------------------------------------------------
# Cache de llamadas al modelo. Se rehace sola; con ella caliente, reprocesar
# el blind set entero es instantaneo y gratis.
.cache_llm/

# Intermedios de docs/activos. Los PDF finales SI van versionados; el HTML que
# los produce y las capturas de revision, no (render.py y md_a_pdf.py).
docs/activos/*-doc.html
docs/activos/*.render.html
docs/activos/*.png
!docs/activos/sapira-logo.png

# ---------------------------------------------------------------------------
# Herramientas
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

node_modules/
front/node_modules/

# Andamiaje del flujo de trabajo con el que se construyo esto: briefs de tarea,
# diffs de revision y notas de progreso. Util mientras se desarrolla, ruido
# para quien clona.
.superpowers/

# ---------------------------------------------------------------------------
# Sistema
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
